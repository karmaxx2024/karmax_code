class Rectangle:
    def __init__(self, width, height):
        self.width = width
        self.height = height

    def area(self):
        return self.width * self.height

    def perimeter(self):
        return 2 * (self.width + self.height)

# Пример использования
rect = Rectangle(5, 10)
print(f"Площадь: {rect.area()}")
print(f"Периметр: {rect.perimeter()}")


