        self.height = height
        self.inventory = Inventory()
        self.characteristics = {
            'сила': 1,
            'ловкость': 1,
            'интелект': 1,
            'общение': 1,
            'здоровье': 100
        }
        self.level = 1
        self.experience = 0
        self.experience_to_next_level = 100


def perform_quest():
    quest = random.choice(quests)
    print(f'Начался квест: {quest["description"]}')

    # Обработка событий квеста
    for event in quest['events']:
        print(f'\nСобытие: {event["description"]}')
        for key, choice in event['choices'].items():
            print(f'{key}, {choice["description"]}')
        while True:
            user_choice = input('Что вы выбираете: ').strip()
            if user_choice in event['choices']:
                choice = event['choices'][user_choice]
                print(choice['outcome'])
                if 'attributes' in choice:
                    for attr, value in choice['attributes'].items():
                        characteristics[attr] += value
                        print(f'{attr}: {characteristics[attr]}')
                if 'inventory' in choice:
                    inventory.extend(choice['inventory'])
                    print(f'Инвентарь: {inventory}')
                break
            else:
                print('Неверный выбор, попробуйте еще раз.')


# Вызов функции выполнения квеста
perform_quest()


