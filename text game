class Inventory:
    def __init__(self):
        self.items = []

    def remove_item(self, item):
        if item in self.items:
            self.items.remove(item)
            print(f'Удалено из инвентаря: {item}')
        else:
            print(f'Предмет "{item}" не найден в инвентаре.')

    def add_item(self, item):
        self.items.append(item)
        print(f'Добавлено в инвентарь: {item}')

    def show_inventory(self, items):
        print('---Инвентарь персонажа---')
        if self.items:
            for item in self.items:
                print(f'- {item}')
        else:
            print('у вас в инвенторе нечего нет.')
        print()


class Character:
    def __init__(self, name, hair_color, skin_color, eye_color, height):
