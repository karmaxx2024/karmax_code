def count_words(text):
    text = text.lower()

    words = text.split()

    word_count = {}

    for word in words:
        if word in word_count:
            word_count[word] += 1
        else:
            word_count[word] = 1

    return word_count


# Пример использования
text = "кот собака кот мышь собака кот"
result = count_words(text)
print(result)  # Вывод: {'кот': 3, 'собака': 2, 'мышь': 1}
