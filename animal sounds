class Animal:
    def __init__(self, name):
        self.name = name

    def speak(self):
        print(f"{self.name} издает звук.")

class Dog(Animal):
    def speak(self):
        print(f"{self.name} лает.")

class Cat(Animal):
    def speak(self):
        print(f"{self.name} мяукает.")

# Пример использования
dog = Dog("Бобик")
cat = Cat("Мурка")

dog.speak()
cat.speak()








